# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but commit the no-secrets template so required vars are documented.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# visual-diff workflow: local screenshots regenerate every run
/screenshots/local/

# diff-dom.ts script output — regenerated each run
/screenshots/diff-dom/

# Ad-hoc debug screenshots dropped in repo root during visual-diff sessions.
# Real assets live under /public/ and /screenshots/, so any *.png at the repo
# root is a stray. (See CLAUDE.md §5.6.)
/*.png

# Ad-hoc working/scratch files dropped in the repo root (e.g. draft emails,
# notes) — not site assets and not needed for publishing. Same rationale as the
# stray-PNG rule above. Real docs (README, CLAUDE, TODO, CHANGELOG) are *.md.
/*.txt

# Playwright MCP scratch artifacts
.playwright-mcp/

# Claude Code per-user settings
.claude/settings.local.json

# NWMLS / MLS Grid licensing source documents — internal reference only.
# Sensitive (payment receipt, good-standing cert) and heavy binaries; not
# production assets. Kept locally; the distilled requirements live in
# content/legal/nwmls-idx-vendor-requirements.md. Production-displayed assets
# (e.g. the NWMLS three-tree icon) get a tracked copy under /public/images/.
/content/legal/nwmls/

# Generated by `npm run sync:idx` from the MLS Grid feed — regenerated at build
# time (Netlify build runs sync:idx), not source. Demo/real listing data + its
# locally-cached media should not be committed.
/data/mlsgrid-demo.json
/public/idx/
