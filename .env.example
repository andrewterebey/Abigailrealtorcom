# Environment variables for the Abigail Anderson realtor site.
# Copy this file to `.env.local` and fill in real values. NEVER commit secrets —
# `.env.local` is gitignored; only this no-secrets template is committed.
# In production, set these in the Netlify dashboard (Site settings → Environment).

# ── IDX / MLS Grid (NWMLS) ────────────────────────────────────────────────────
# OAuth2 access token from your MLS Grid account. Use the DEMO subscription
# token for the staging/review site; the production token is different.
# When set, the site serves the synced NWMLS feed; when unset, it falls back to
# fabricated placeholder data with NWMLS branding OFF (the legal guardrail).
# Server-only secret — do NOT prefix with NEXT_PUBLIC_.
MLSGRID_TOKEN=

# MLS Grid API base (default shown).
MLSGRID_API_BASE=https://api.mlsgrid.com/v2

# OriginatingSystemName filter for NWMLS (confirmed value: "nwmls").
MLSGRID_ORIGINATING_SYSTEM=nwmls

# Show NWMLS attribution/branding in the UI (three-tree icon, "courtesy of
# NWMLS", MLS Grid disclaimers). Set to "true" on the IDX (demo/prod) site.
# Public (sent to the browser) — never put a secret in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_IDX_NWMLS=true

# ── Existing site vars (see CLAUDE.md §4) ─────────────────────────────────────
# Base URL for sitemap.xml / canonicals (falls back to https://abigailrealtor.com).
NEXT_PUBLIC_SITE_URL=

# Show the footer social-icon row once real profile URLs exist.
NEXT_PUBLIC_SHOW_SOCIALS=

# Production contact-form email via Resend. Unset in dev = console log only.
RESEND_API_KEY=
